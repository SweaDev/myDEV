{
  "name": "mydev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.6",
    "eslint": "^10.13.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsx scripts/build.ts",
    "build:chrome": "tsx scripts/build.ts chrome",
    "build:firefox": "tsx scripts/build.ts firefox",
    "dev": "tsx scripts/build.ts --watch",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "zip": "pnpm zip:chrome && pnpm zip:firefox",
    "zip:chrome": "web-ext build --source-dir dist/chrome --artifacts-dir dist --filename mydev-chrome.zip --overwrite-dest",
    "zip:firefox": "web-ext build --source-dir dist/firefox --artifacts-dir dist --filename mydev-firefox.zip --overwrite-dest",
    "audit:prod": "pnpm audit --prod"
  }
}
