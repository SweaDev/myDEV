{
  "manifest_version": 3,
  "name": "myDEV",
  "version": "0.0.0",
  "description": "Adds a personal myDEV feed to dev.to: tick posts to move them out of the main feeds.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://dev.to/*"],
      "run_at": "document_start",
      "js": ["content.js"],
      "css": ["mydev.css"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
